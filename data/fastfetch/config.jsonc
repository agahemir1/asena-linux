// Installed as /etc/xdg/fastfetch/config.jsonc (K07): the Asena logo in the
// tile's turquoise and the weave's ivory. fastfetch 2.40 prints no modules
// when a configuration file leaves them out, so the list is spelled out.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/asena/fastfetch/logo.txt",
        "color": {
            "1": "38;2;37;167;166",
            "2": "38;2;244;234;214"
        }
    },
    "display": {
        "color": {
            "keys": "38;2;37;167;166"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "theme",
        "icons",
        "font",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "locale",
        "break",
        "colors"
    ]
}
