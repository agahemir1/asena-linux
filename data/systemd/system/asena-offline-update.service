[Unit]
Description=Install downloaded Asena system updates
DefaultDependencies=no
# The offline mode talks to APT, dpkg and Plymouth only; no D-Bus.
Requires=sysinit.target
After=sysinit.target system-update-pre.target systemd-journald.socket
Before=shutdown.target system-update.target
ConditionPathExists=/system-update

[Service]
Type=oneshot
ExecStart=/usr/libexec/asena-packages --offline-update
Environment=DEBIAN_FRONTEND=noninteractive
# A failed upgrade restarts too; the result waits for the next login.
FailureAction=reboot
# The service starts the reboot itself, and systemd stops it on the way.
SuccessExitStatus=SIGTERM

[Install]
WantedBy=system-update.target
