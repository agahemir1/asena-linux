<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="asena">
  <schema id="org.asenalinux.input" path="/org/asenalinux/input/">
    <key name="keyboard-layouts" type="as"><default>['tr', 'us']</default><summary>Keyboard layouts</summary></key>
    <key name="keyboard-toggle" type="s"><choices><choice value="grp:alt_shift_toggle"/><choice value="grp:win_space_toggle"/></choices><default>'grp:alt_shift_toggle'</default><summary>Switch layout</summary></key>
    <key name="repeat-rate" type="i"><range min="1" max="100"/><default>25</default><summary>Repeat rate</summary></key>
    <key name="repeat-delay" type="i"><range min="100" max="2000"/><default>600</default><summary>Repeat delay</summary></key>
    <key name="pointer-speed" type="d"><range min="-1.0" max="1.0"/><default>0.0</default><summary>Pointer speed</summary></key>
    <key name="natural-scroll" type="b"><default>false</default><summary>Natural scrolling</summary></key>
    <key name="tap-to-click" type="b"><default>true</default><summary>Tap to click</summary></key>
  </schema>
</schemalist>
