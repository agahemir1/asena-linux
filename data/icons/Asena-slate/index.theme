[Icon Theme]
Name=Asena-slate
Comment=Asena icons with slate folders
Inherits=Asena,Adwaita,hicolor
Hidden=true
Directories=scalable/apps,scalable/places

[scalable/apps]
Context=Applications
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=1024
Type=Scalable
