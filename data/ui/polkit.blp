using Gtk 4.0;
using Adw 1;
template $AsenaAuthorizationContent : Box {
  orientation: vertical;
  Adw.HeaderBar { }
  ScrolledWindow {
    vexpand: true;
    hscrollbar-policy: never;
    Adw.Clamp {
      maximum-size: 420;
      Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 24;
        margin-start: 24;
        margin-end: 24;
        Label description { wrap: true; xalign: 0; }
        DropDown identities { }
        Label prompt { wrap: true; xalign: 0; }
        PasswordEntry password { show-peek-icon: false; activates-default: true; }
        Entry answer { max-length: 4096; activates-default: true; visible: false; }
        Label message { wrap: true; xalign: 0; visible: false; }
        Box {
          spacing: 8;
          Button cancel { hexpand: true; }
          Button submit { hexpand: true; styles ["suggested-action"] }
        }
      }
    }
  }
}
