using Gtk 4.0;
using Adw 1;

template $AsenaLockContent : Box {
  orientation: vertical;
  ScrolledWindow {
    vexpand: true;
    hscrollbar-policy: never;
    Adw.Clamp {
      maximum-size: 360;
      Box {
        orientation: vertical;
        spacing: 12;
        valign: center;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 24;
        margin-end: 24;
        Label clock { styles ["title-1"] }
        Label date { }
        Adw.Avatar avatar { size: 64; show-initials: true; halign: center; }
        Label name { wrap: true; }
        Box authentication {
          orientation: vertical;
          spacing: 12;
          Label prompt { wrap: true; xalign: 0; }
          PasswordEntry password { activates-default: true; show-peek-icon: false; }
          Entry answer { activates-default: true; visible: false; }
          Label keyboard { xalign: 0; visible: false; }
          Label caps { xalign: 0; visible: false; }
          Label message { wrap: true; xalign: 0; }
          Box {
            spacing: 8;
            Button cancel { hexpand: true; }
            Button submit { hexpand: true; styles ["suggested-action"] }
          }
        }
        Image logo { icon-name: "asena-logo"; pixel-size: 40; halign: center; margin-top: 12; }
      }
    }
  }
}
