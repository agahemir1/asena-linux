using Gtk 4.0;
using Adw 1;

template $AsenaGreeterContent : Box {
  orientation: vertical;
  ScrolledWindow {
    vexpand: true;
    hscrollbar-policy: never;
    Adw.Clamp {
      maximum-size: 400;
      Box {
        orientation: vertical;
        spacing: 12;
        valign: center;
        margin-top: 24;
        margin-bottom: 24;
        margin-start: 24;
        margin-end: 24;
        Adw.Avatar avatar { size: 64; show-initials: true; halign: center; }
        DropDown users { visible: false; }
        Entry username { max-length: 256; }
        DropDown sessions { }
        Label prompt { wrap: true; xalign: 0; }
        PasswordEntry password { activates-default: true; show-peek-icon: false; visible: false; }
        Entry answer { max-length: 4096; activates-default: true; visible: false; }
        Label keyboard { xalign: 0; visible: false; }
        Label caps { xalign: 0; visible: false; }
        Label message { wrap: true; xalign: 0; }
        Box {
          spacing: 8;
          Button cancel { hexpand: true; }
          Button submit { hexpand: true; styles ["suggested-action"] }
        }
        Box power { spacing: 8; halign: center; }
      }
    }
  }
}
