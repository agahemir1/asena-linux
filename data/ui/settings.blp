using Gtk 4.0;
using Adw 1;

template $AsenaSettingsContent : Box {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  Adw.BreakpointBin breakpoints {
    width-request: 360;
    height-request: 294;
    hexpand: true;
    vexpand: true;

    Adw.Breakpoint {
      condition ("max-width: 620sp")

      setters {
        split.collapsed: true;
      }
    }

    child: Adw.NavigationSplitView split {
      hexpand: true;
      vexpand: true;
      min-sidebar-width: 220;
      max-sidebar-width: 280;

      sidebar: Adw.NavigationPage sidebar {
        title: _("Settings");
        tag: "sidebar";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          [top]
          Adw.Bin {
            margin-start: 12;
            margin-end: 12;
            margin-bottom: 8;

            SearchEntry search {
              placeholder-text: _("Search settings");
            }
          }

          content: ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            ListBox categories {
              selection-mode: single;
              activate-on-single-click: true;

              styles [
                "navigation-sidebar",
              ]
            }
          };
        };
      };

      content: Adw.NavigationPage page {
        title: _("Appearance");
        tag: "content";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Box {
            orientation: vertical;
            hexpand: true;
            vexpand: true;

            Label error {
              wrap: true;
              xalign: 0;
              visible: false;
              margin-start: 24;
              margin-end: 24;
              margin-top: 8;

              styles [
                "error",
              ]
            }

            Stack stack {
              vexpand: true;
              hexpand: true;
              hhomogeneous: false;
              vhomogeneous: false;
            }
          };
        };
      };
    };
  }
}
