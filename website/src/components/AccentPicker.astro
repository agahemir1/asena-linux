---
import Screen from './Screen.astro';
import { accents, folderIcon } from '../lib/media';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// The names Settings › Appearance shows for each libadwaita accent.
const names = {
  tr: { blue: 'Mavi', teal: 'Camgöbeği', green: 'Yeşil', yellow: 'Sarı', orange: 'Turuncu', red: 'Kırmızı', pink: 'Pembe', purple: 'Mor', slate: 'Arduvaz' },
  en: { blue: 'Blue', teal: 'Teal', green: 'Green', yellow: 'Yellow', orange: 'Orange', red: 'Red', pink: 'Pink', purple: 'Purple', slate: 'Slate' },
}[lang];
const copy = {
  tr: { label: 'Vurgu rengi', alt: (n: string) => `Ayarlar › Görünüm, vurgu rengi ${n}`, folders: 'Klasör simgeleri de vurguyu izler.' },
  en: { label: 'Accent color', alt: (n: string) => `Settings › Appearance with the ${n} accent`, folders: 'Folder icons follow the accent too.' },
}[lang];
const folders = ['folder', 'folder-documents', 'folder-download', 'folder-pictures', 'folder-music', 'folder-videos'];
---

<div class="accent-picker" data-accent-picker>
  <div class="swatches" role="radiogroup" aria-label={copy.label}>
    {
      accents.map((accent) => (
        <button
          type="button"
          role="radio"
          aria-checked={accent === 'teal' ? 'true' : 'false'}
          tabindex={accent === 'teal' ? 0 : -1}
          data-accent={accent}
          style={`--swatch: var(--accent-${accent})`}
        >
          <span class="dot" aria-hidden="true" />
          <span class="name">{names[accent]}</span>
        </button>
      ))
    }
  </div>
  <div class="views">
    <div class="settings shot">
      {
        accents.map((accent) => (
          <div class="layer" data-for={accent} data-active={accent === 'teal' ? '' : undefined}>
            <Screen lang={lang} name={`accent-${accent}`} alt={copy.alt(names[accent])} sizes="(min-width: 960px) 640px, 92vw" />
          </div>
        ))
      }
    </div>
    <figure class="folders">
      {
        accents.map((accent) => (
          <div class="row" data-for={accent} data-active={accent === 'teal' ? '' : undefined}>
            {folders.map((name, i) => (
              <img src={folderIcon(accent, name).src} width="72" height="72" alt="" loading="lazy" style={`--i:${i}`} />
            ))}
          </div>
        ))
      }
      <figcaption>{copy.folders}</figcaption>
    </figure>
  </div>
</div>

<style>
  .swatches { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5); }
  .swatches button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 6px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    font-size: var(--fs-small);
    transition: border-color var(--dur-state) ease, transform var(--dur-state) var(--ease-out-cubic);
  }
  .swatches button:hover { transform: translateY(-1px); border-color: var(--border-strong); }
  .swatches button[aria-checked='true'] { border-color: var(--swatch); box-shadow: 0 0 0 3px color-mix(in oklab, var(--swatch) 25%, transparent); }
  .dot { width: 22px; height: 22px; border-radius: 50%; background: var(--swatch); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12); }
  .views { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-6); align-items: center; }
  .settings { position: relative; aspect-ratio: 1896 / 1356; }
  .layer, .row { opacity: 0; transition: opacity 360ms var(--ease-out-cubic); }
  .layer { position: absolute; inset: 0; }
  .layer :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .layer[data-active], .row[data-active] { opacity: 1; }
  .folders { position: relative; display: grid; gap: var(--space-4); }
  .row { grid-area: 1 / 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); justify-items: center; }
  .row img { width: min(100%, 88px); height: auto; filter: drop-shadow(0 8px 12px rgb(0 0 0 / 0.25)); }
  .row[data-active] img { animation: pop 520ms var(--ease-out-expo) both; animation-delay: calc(var(--i) * 40ms); }
  @keyframes pop { from { transform: translateY(10px) scale(0.92); opacity: 0; } }
  figcaption { grid-area: 2 / 1; color: var(--text-secondary); font-size: var(--fs-small); text-align: center; }
  @media (max-width: 860px) { .views { grid-template-columns: 1fr; } }
</style>

<script>
  const valid = ['blue', 'teal', 'green', 'yellow', 'orange', 'red', 'pink', 'purple', 'slate'];
  for (const picker of document.querySelectorAll<HTMLElement>('[data-accent-picker]')) {
    const buttons = [...picker.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    const show = (accent: string, focus = false) => {
      buttons.forEach((button) => {
        const on = button.dataset.accent === accent;
        button.setAttribute('aria-checked', String(on));
        button.tabIndex = on ? 0 : -1;
        if (on && focus) button.focus();
      });
      picker.querySelectorAll<HTMLElement>('[data-for]').forEach((el) => el.toggleAttribute('data-active', el.dataset.for === accent));
    };
    const apply = (accent: string, focus = false) => {
      show(accent, focus);
      const root = document.documentElement;
      if (accent === 'teal') delete root.dataset.accent;
      else root.dataset.accent = accent;
      try {
        if (accent === 'teal') localStorage.removeItem('asena-accent');
        else localStorage.setItem('asena-accent', accent);
      } catch {}
    };
    const current = document.documentElement.dataset.accent;
    if (current && valid.includes(current)) show(current);
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => apply(button.dataset.accent ?? 'teal'));
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        apply(next.dataset.accent ?? 'teal', true);
      });
    });
  }
</script>
