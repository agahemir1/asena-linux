---
// The Asena emblem (data/branding/asena-emblem.svg). Its eight-pointed star is
// first drawn as an outline, then the glazed tile settles in.
import emblem from '@data/branding/asena-emblem.svg';

interface Props {
  size?: string;
}

const { size = 'clamp(88px, 12vw, 148px)' } = Astro.props;
const star = 'M64 10.09L78.91 25L100 25L100 46.09L114.91 61L100 75.91L100 97L78.91 97L64 111.91L49.09 97L28 97L28 75.91L13.09 61L28 46.09L28 25L49.09 25Z';
---

<div class="emblem" style={`--size:${size}`}>
  <svg class="draw" viewBox="0 0 128 128" aria-hidden="true">
    <path class="outer" d={star} pathLength="1" />
    <path class="inner" d="M64 24.94L100.06 61L64 97.06L27.94 61Z" pathLength="1" />
    <path class="inner two" d="M38.5 35.5L89.5 35.5L89.5 86.5L38.5 86.5Z" pathLength="1" />
  </svg>
  <img class="tile" src={emblem.src} width="128" height="128" alt="" />
</div>

<style>
  .emblem { position: relative; width: var(--size); aspect-ratio: 1; }
  .emblem > * { position: absolute; inset: 0; width: 100%; height: 100%; }
  .draw path {
    fill: none;
    stroke: var(--brand-glaze-1);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1300ms var(--ease-out-cubic) 200ms forwards, fade-line 600ms ease 1700ms forwards;
  }
  .draw .inner { stroke: var(--brand-band); stroke-width: 1; animation-delay: 650ms, 1700ms; }
  .draw .two { animation-delay: 850ms, 1700ms; }
  .tile {
    opacity: 0;
    transform: scale(0.9) translateY(4px);
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45)) drop-shadow(0 0 40px color-mix(in oklab, var(--brand-glaze-1) 25%, transparent));
    animation: settle 900ms var(--ease-out-expo) 1350ms forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-line { to { opacity: 0; } }
  @keyframes settle { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .draw { display: none; }
    .tile { opacity: 1; transform: none; animation: none; }
  }
</style>
