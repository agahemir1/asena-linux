---
// The boot sequence as recorded by scripts/test-boot-vm.sh on 23 October 2026
// (docs/reports/evidence/boot-test), and the fastfetch logo it printed.
import { Image } from 'astro:assets';
import { bootShot } from '../lib/media';
import logo from '@data/branding/asena-logo.txt?raw';
import fastfetch from '@evidence/boot-test/fastfetch.txt?raw';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = {
  tr: {
    steps: [
      ['live-grub-splash', 'Canlı önyükleme menüsü'],
      ['grub-booting', 'GRUB: “Booting Asena GNU/Linux”'],
      ['plymouth-splash', 'Plymouth açılış ekranı'],
    ],
    terminal: 'fastfetch',
    caption: 'Görüntüler ve çıktı, 23 Ekim 2026’daki sanal makine açılış testinden.',
  },
  en: {
    steps: [
      ['live-grub-splash', 'Live boot menu'],
      ['grub-booting', 'GRUB: “Booting Asena GNU/Linux”'],
      ['plymouth-splash', 'Plymouth boot splash'],
    ],
    terminal: 'fastfetch',
    caption: 'Images and output from the virtual machine boot test of 23 October 2026.',
  },
}[lang];

// $1 and $2 mark the two logo colors in fastfetch's logo file.
const logoLines = logo
  .replace(/\n$/, '')
  .split('\n')
  .map((line) =>
    line
      .split(/(\$[12])/)
      .reduce<{ parts: { tone: string; text: string }[]; tone: string }>(
        (state, piece) => {
          if (piece === '$1' || piece === '$2') return { ...state, tone: piece === '$1' ? 'a' : 'b' };
          if (piece) state.parts.push({ tone: state.tone, text: piece });
          return state;
        },
        { parts: [], tone: 'a' },
      ).parts,
  );
const info = fastfetch
  .split('\n')
  .filter((line) => /^(\S+@\S+|-+|[A-Za-z ()]+: )/.test(line))
  .map((line) => {
    const at = line.indexOf(': ');
    return at > 0 && !line.includes('@') ? { key: line.slice(0, at), value: line.slice(at + 2) } : { key: '', value: line };
  });
---

<div class="boot">
  <ol class="frames">
    {
      copy.steps.map(([name, label], i) => (
        <li data-reveal="scale" style={`--reveal-i:${i}`}>
          <figure>
            <div class="screen">
              <Image src={bootShot(name)} alt={label} format="webp" widths={[480, 800, 1280]} sizes="(min-width: 960px) 30vw, 92vw" loading="lazy" />
            </div>
            <figcaption>
              <span class="n">{i + 1}</span>
              {label}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
  <figure class="terminal" data-reveal data-typing>
    <div class="bar" aria-hidden="true"><span></span><span></span><span></span><strong>{copy.terminal}</strong></div>
    <div class="body">
      <pre class="logo" aria-hidden="true">{logoLines.map((parts) => <span class="line">{parts.map((part) => <span class:list={[part.tone]}>{part.text}</span>)}{'\n'}</span>)}</pre>
      <dl class="info">
        {
          info.map((row) => (
            <div class="line">
              {row.key ? (
                <>
                  <dt>{row.key}</dt>
                  <dd>{row.value}</dd>
                </>
              ) : (
                <dd class="plain">{row.value}</dd>
              )}
            </div>
          ))
        }
      </dl>
    </div>
    <figcaption>{copy.caption}</figcaption>
  </figure>
</div>

<style>
  .frames { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); counter-reset: f; }
  .screen { aspect-ratio: 16 / 10; border-radius: var(--radius-card); overflow: hidden; background: var(--scrim); box-shadow: var(--shadow-soft); outline: 1px solid var(--border-subtle); }
  .screen :global(img) { width: 100%; height: 100%; object-fit: contain; }
  figcaption { display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-3); font-size: var(--fs-small); color: var(--text-secondary); }
  .n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent-subtle); color: var(--accent-text); font-size: var(--fs-xs); font-weight: 650; }
  @media (max-width: 760px) { .frames { grid-template-columns: 1fr; } }

  .terminal { margin-top: var(--space-6); }
  .terminal > figcaption { margin-top: var(--space-3); }
  .bar, .body { background: var(--scrim); color: var(--on-image); }
  .bar { display: flex; align-items: center; gap: 7px; padding: 10px 14px; border-radius: var(--radius-card) var(--radius-card) 0 0; border-bottom: 1px solid var(--on-image-line); }
  .bar span { width: 11px; height: 11px; border-radius: 50%; background: var(--on-image-line); }
  .bar strong { margin-left: var(--space-3); font: 500 var(--fs-xs) var(--font-mono); color: var(--on-image-3); }
  .body { display: flex; flex-wrap: wrap; gap: var(--space-6); align-items: center; padding: var(--space-5) var(--space-5) var(--space-6); border-radius: 0 0 var(--radius-card) var(--radius-card); overflow-x: auto; font-family: var(--font-mono); font-size: clamp(0.62rem, 0.5rem + 0.45vw, 0.85rem); line-height: 1.35; }
  .logo { margin: 0; font: inherit; }
  .logo .a { color: var(--brand-glaze-2); }
  .logo .b { color: var(--brand-band); }
  .info { display: grid; gap: 2px; }
  .info .line { display: flex; gap: 0.6ch; }
  .info dt { color: var(--brand-glaze-1); font-weight: 700; }
  .info dt::after { content: ':'; }
  .info .plain { color: var(--on-image); font-weight: 700; }
  :global(.js) [data-typing] .line { opacity: 0; }
  :global(.js) [data-typing].is-visible .line { animation: type 1ms linear forwards; animation-delay: calc(var(--l, 0) * 55ms + 300ms); }
  @keyframes type { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(.js) [data-typing] .line { opacity: 1; } }
</style>

<script>
  // Lines appear one after another, logo first, like a command finishing.
  document.querySelectorAll<HTMLElement>('[data-typing]').forEach((block) => {
    block.querySelectorAll<HTMLElement>('.line').forEach((line, i) => line.style.setProperty('--l', String(i)));
  });
</script>
