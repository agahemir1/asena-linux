---
import { route, type Lang, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';
import logo from '@data/icons/hicolor/scalable/apps/asena-logo.svg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const links: { key: RouteKey; label: string }[] = [
  { key: 'desktop', label: t('nav.desktop') },
  { key: 'apps', label: t('nav.apps') },
  { key: 'story', label: t('nav.story') },
  { key: 'why', label: t('nav.why') },
  { key: 'docs', label: t('nav.docs') },
  { key: 'news', label: t('nav.news') },
  { key: 'download', label: t('nav.download') },
];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <a class="brand" href={route('home', lang)}>
        <img src={logo.src} width="40" height="40" alt="" />
        <span>Asena Linux</span>
      </a>
      <p class="status">{t('footer.status')}</p>
    </div>
    <nav aria-label={t('nav.label')}>
      <ul>
        {links.map(({ key, label }) => <li><a href={route(key, lang)}>{label}</a></li>)}
        <li><a href={`${route('news', lang)}rss.xml`}>{t('footer.rss')}</a></li>
      </ul>
    </nav>
    <div class="legal">
      <p>{t('footer.code')} {t('footer.wallpapers')}</p>
      <p>{t('footer.debian')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    padding-block: var(--space-8) var(--space-7);
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-sunken);
    font-size: var(--fs-small);
  }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.02em; }
  .status { color: var(--text-secondary); }
  nav { margin-block: var(--space-6); }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); list-style: none; padding: 0; }
  nav a { color: var(--text-primary); text-decoration: none; }
  nav a:hover { color: var(--accent-text); }
  .legal { display: grid; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: var(--fs-xs); }
</style>
