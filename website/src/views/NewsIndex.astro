---
import Base from '../layouts/Base.astro';
import { newsFor } from '../lib/content';
import { newsPath, route, type Lang } from '../i18n/routes';
import { formatDate, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const posts = await newsFor(lang);
const c = {
  tr: { title: 'Haberler', description: 'Asena Linux geliştirme günlüğü: yapılanlar, kararlar ve denemeler.', lead: 'Neyin yapıldığını, neye karar verildiğini ve neyin denendiğini buraya yazıyoruz. Abone olmak için RSS akışını kullanabilirsiniz.' },
  en: { title: 'News', description: 'The Asena Linux development log: what was built, what was decided and what was tested.', lead: 'What was built, what was decided and what was tested goes here. Follow along with the RSS feed.' },
}[lang];
---

<Base lang={lang} title={c.title} description={c.description} alternate={route('news', other)}>
  <header class="page-intro wrap">
    <h1 data-reveal>{c.title}</h1>
    <p class="lead" data-reveal style="--reveal-i:1">{c.lead} <a href={`${route('news', lang)}rss.xml`}>{t('footer.rss')}</a></p>
  </header>
  <ol class="wrap timeline">
    {
      posts.map((post, i) => (
        <li data-reveal style={`--reveal-i:${i % 3}`}>
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time>
          <a href={newsPath(lang, post.data.permalink)}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .timeline { list-style: none; padding: 0; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 160px; top: 0; bottom: 0; width: 1px; background: var(--border-subtle); }
  .timeline li { position: relative; display: grid; grid-template-columns: 160px 1fr; gap: var(--space-6); padding-block: var(--space-5); }
  .timeline li::before { content: ''; position: absolute; left: 155px; top: calc(var(--space-5) + 0.55em); width: 11px; height: 11px; border-radius: 50%; background: var(--surface-base); border: 2px solid var(--accent); }
  time { font-size: var(--fs-small); color: var(--text-secondary); padding-top: 2px; text-align: right; padding-right: var(--space-5); }
  .timeline a { display: grid; gap: var(--space-2); padding-left: var(--space-3); color: inherit; text-decoration: none; }
  .timeline h2 { font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem); transition: color var(--dur-state) ease; }
  .timeline a:hover h2 { color: var(--accent-text); }
  .timeline p { color: var(--text-secondary); max-width: 62ch; }
  @media (max-width: 640px) {
    .timeline::before, .timeline li::before { left: 4px; }
    .timeline::before { left: 9px; }
    .timeline li { grid-template-columns: 1fr; gap: var(--space-2); padding-left: var(--space-6); }
    time { text-align: left; padding: 0 0 0 var(--space-3); }
  }
</style>
