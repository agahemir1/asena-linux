---
import DocPage from '../../../views/DocPage.astro';
import { docsFor } from '../../../lib/content';

export async function getStaticPaths() {
  const docs = await docsFor('en');
  return docs.map((entry) => ({ params: { slug: entry.data.permalink }, props: { entry } }));
}

const { entry } = Astro.props;
---

<DocPage lang="en" entry={entry} />
