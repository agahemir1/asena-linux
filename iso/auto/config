#!/bin/sh
# live-build configuration for the Asena live ISO (Phase 6C skeleton).
# Values marked as proposals wait for decisions in docs/PLANNING.md
# (K09 install scope, K19 firmware); see iso/README.md.
set -e

# Proposal (K09): amd64 and UEFI only.
# K20: shim and GRUB come from Debian's signed packages. XanMod is unsigned,
# so under Secure Boot the live menu boots Debian's signed kernel
# (config/hooks/live/0100-asena-kernel-menu.hook.binary). Secure Boot support
# is not claimed until the image is verified with it.
# Proposal (K19): Debian's own default since 12, firmware from
# non-free-firmware so common Wi-Fi and GPU hardware works in the live system.
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --archive-areas "main non-free-firmware" \
    --security true \
    --updates true \
    --backports false \
    --binary-images iso-hybrid \
    --bootloaders grub-efi \
    --uefi-secure-boot enable \
    --bootappend-live "boot=live components quiet splash preempt=full" \
    --debian-installer none \
    --firmware-chroot true \
    --firmware-binary false \
    --iso-application "Asena Linux" \
    --iso-volume "Asena Linux" \
    "${@}"
