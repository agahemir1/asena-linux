#!/bin/sh
# Live boot menu (K20). Runs in binary/ after live-build wrote
# boot/grub/grub.cfg from config/bootloaders/grub-pc/grub.cfg. Fills in the
# XanMod kernel version and checks that the fallback entry, the first entry
# of the advanced submenu, boots Debian's signed kernel.
set -e
cfg=boot/grub/grub.cfg
xanmod=$(find live -maxdepth 1 -name 'vmlinuz-*-xanmod*' -printf '%f\n' | sort -V | tail -n 1)
version=${xanmod#vmlinuz-}
if [ -z "$xanmod" ] || [ ! -e "live/initrd.img-$version" ]; then
    echo 'asena-kernel-menu: no XanMod kernel and initrd in live/' >&2
    exit 1
fi
if ! grep -q '@ASENA_XANMOD@' "$cfg"; then
    echo "asena-kernel-menu: $cfg lacks @ASENA_XANMOD@" >&2
    exit 1
fi
first=$(sed -n '/^submenu "Gelişmiş seçenekler"/,/^}/p' "$cfg" | grep -m 1 'menuentry ')
case $first in
    *'(amd64)'*) ;;
    *)
        echo "asena-kernel-menu: fallback entry is not the Debian kernel: $first" >&2
        exit 1
        ;;
esac
sed -i "s|@ASENA_XANMOD@|$version|g" "$cfg"
